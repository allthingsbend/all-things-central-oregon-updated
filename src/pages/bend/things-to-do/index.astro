---
import Layout from '../../../layouts/Layout.astro';

const title = 'Best Things To Do in Bend, Oregon';
const description = 'Explore the best things to do in Bend, Oregon including hiking, lakes, breweries, coffee shops, fishing, camping, and outdoor adventures.';
---

<Layout title={title} description={description}>
  <section class="hero">
    <div class="container">
      <h1>Best Things To Do in Bend, Oregon</h1>
      <p>
        Bend is one of the best outdoor towns in the Pacific Northwest. From mountain lakes and hiking trails to breweries and coffee shops, there is something for everyone year-round.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Outdoor Activities</h2>

      <h3>Hiking Near Bend</h3>
      <p>
        Popular hiking areas include Smith Rock, Tumalo Falls, Sparks Lake, and the Cascade Lakes Highway.
      </p>

      <h3>Lakes & Paddleboarding</h3>
      <p>
        Elk Lake, Sparks Lake, and Cultus Lake are popular during summer for kayaking, paddleboarding, and relaxing near the water.
      </p>

      <h3>Fishing</h3>
      <p>
        Central Oregon has excellent trout fishing opportunities in both lakes and rivers including the Deschutes River and nearby mountain lakes.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Food & Drink</h2>

      <h3>Coffee Shops</h3>
      <p>
        Bend has a strong local coffee scene with cozy cafes, drive-thru stands, and local roasters throughout town.
      </p>

      <h3>Breweries</h3>
      <p>
        Bend is known for craft beer and has one of the highest brewery counts per capita in the country.
      </p>
    </div>
  </section>
</Layout>
