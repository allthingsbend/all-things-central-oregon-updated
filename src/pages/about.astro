---
import Layout from '../layouts/Layout.astro';
import about from '../data/about.json';
---

<Layout
  title={about.seo.title}
  description={about.seo.description}
>
  <main>
    <section class="page-hero">
      <div class="container narrow">
        <p class="section-label">{about.hero.eyebrow}</p>
        <h1>{about.hero.title}</h1>
        <p>{about.hero.description}</p>
      </div>
    </section>

    <section class="intro">
      <div class="container narrow">
        {about.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets.length > 0 && (
              <ul>
                {section.bullets.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        ))}

        <a href={about.callToAction.url} class="primary-btn">{about.callToAction.label}</a>
      </div>
    </section>
  </main>
</Layout>
