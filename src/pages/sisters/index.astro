---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Sisters Guide" description="Everything Sisters, Oregon. From the mountains to the town.">
	<h1 style="font-size: 3rem; margin-bottom: 10px;">Sisters</h1>
	<p style="font-style: italic; color: #2D4F3E; border-left: 4px solid #2D4F3E; padding-left: 15px; font-size: 1.2rem;">
		"Under the watchful eye of the Three Sisters peaks."
	</p>
	<section style="margin-top: 40px; background: white; padding: 30px; border-radius: 12px; border: 1px solid #e5e1d8; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
		<h2>Community & Culture</h2>
		<p>From the Quilt Show to the Rodeo, we’re documenting how to experience Sisters like a local.</p>
	</section>
</Layout>
