---
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | All Things Central Oregon</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <nav class="site-nav">
      <div class="nav-inner">
        <a href="/" class="logo">All Things Central Oregon</a>

        <div class="nav-links">
          <a href="/bend/">Bend</a>
          <a href="/redmond/">Redmond</a>
          <a href="/sisters/">Sisters</a>
          <a href="/sunriver/">Sunriver</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; 2026 All Things Central Oregon. Built by locals.</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    background-color: #faf9f6;
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    margin: 0;
    color: #3e332e;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(45, 79, 62, 0.98);
    color: white;
    border-bottom: 3px solid #d9823b;
  }

  .nav-inner {
    width: min(1200px, 92%);
    margin: 0 auto;
    padding: 1rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .logo {
    color: white;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .nav-links a:hover {
    color: #f3d7a3;
  }

  main {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  footer {
    margin-top: 0;
    padding: 40px 20px;
    text-align: center;
    background: #f0eee9;
    color: #7a746e;
    font-size: 0.85rem;
  }

  @media (max-width: 750px) {
    .nav-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .nav-links {
      gap: 0.9rem;
    }
  }
</style>
