---
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://allthingscentraloregon.org').href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5CN3SW8J');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title} | All Things Central Oregon</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2d4f3e" />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="/styles.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5CN3SW8J"
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <header class="site-header">
      <div class="site-header-inner">
        <a class="logo" href="/">All Things Central Oregon</a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/bend/">Bend</a>
          <a href="/redmond/">Redmond</a>
          <a href="/sisters/">Sisters</a>
          <a href="/sunriver/">Sunriver</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-brand">
          <h3>All Things Central Oregon</h3>
          <p>
            Practical local guides to Bend, Redmond, Sisters, Sunriver, and the surrounding
            high desert.
          </p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} All Things Central Oregon</p>
      </div>
    </footer>
  </body>
</html>
