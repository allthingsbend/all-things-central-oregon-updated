---
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | All Things Central Oregon</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <nav class="site-nav">
      <div class="nav-inner">
        <a href="/" class="logo">All Things Central Oregon</a>

        <div class="nav-links">
          <a href="/bend/">BEND</a>
          <a href="/redmond/">REDMOND</a>
          <a href="/sisters/">SISTERS</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; 2026 All Things Central Oregon. Built by locals.</p>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    background-color: #faf9f6;
    font-family: system-ui, sans-serif;
    margin: 0;
    color: #3e332e;
  }

  .site-nav {
    background: #2d4f3e;
    color: white;
    padding: 1.25rem 1.5rem;
    border-bottom: 4px solid #e5732f;
  }

  .nav-inner {
    width: min(1200px, 92%);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .logo {
    color: white;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .nav-links {
    display: flex;
    gap: 22px;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
  }

  main {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  footer {
    margin-top: 0;
    padding: 40px 20px;
    text-align: center;
    background: #f0eee9;
    color: #7a746e;
    font-size: 0.85rem;
  }

  @media (max-width: 650px) {
    .nav-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links {
      flex-wrap: wrap;
      gap: 14px;
    }
  }
</style>
